# Copie este arquivo para .env e coloque sua chave do Gemini.
# Crie a chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional — só para tocar músicas pelo Spotify (precisa de conta Premium).
# Veja o README, seção "Spotify".
SPOTIFY_CLIENT_ID=

# Opcional — outros provedores de IA, usados quando o Gemini não puder atender (cota, fora do ar).
# Dá para colar as chaves em Ajustes › Provedores de IA; elas são gravadas aqui. Todos são opcionais.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
